# Copie este archivo como .env (no se versiona) y ajuste los valores.
# Lo usan docker compose y el perfil "local" de Spring Boot.

# Base de datos local (compose.yaml)
DB_NOMBRE=prestamos
DB_USUARIO=prestamos
DB_CONTRASENA=cambie-esta-contrasena
DB_PUERTO=5432
DB_HOST=localhost

# Orígenes del frontend permitidos por CORS (separados por coma, sin comodines)
APP_CORS_ORIGENES=http://localhost:5173

# Secreto para firmar los JWT (HS256). Mínimo 32 bytes. Genere uno propio:
#   PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/macOS: openssl rand -base64 48
APP_JWT_SECRETO=reemplace-por-un-secreto-aleatorio-de-al-menos-32-bytes

# Opcional: administrador inicial (solo se crea si no existe). Contraseña de 12+ caracteres.
APP_ADMIN_CORREO=
APP_ADMIN_CONTRASENA=
APP_ADMIN_IDENTIFICACION=ADMIN-0001
